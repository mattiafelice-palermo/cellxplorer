{
  "description": "Synthetic, non-private continuation edge cases covered by Specs 034.1-034.9.",
  "cases": [
    {"id": "normal_continuation", "input": "local 1..3 + local 1..2", "expected": "dense global 1..5", "tests": ["tests.test_stitch.StitchServiceTests.test_two_sources_map_to_dense_global_cycles"]},
    {"id": "missing_local_label", "input": "local 1,2,4", "expected": "observed labels only", "tests": ["tests.test_stitch.StitchServiceTests.test_non_contiguous_local_labels_do_not_invent_cycles"]},
    {"id": "incomplete_first_source_cycle", "input": "partial final cycle in source 1", "expected": "boundary remains explicit", "tests": ["tests.test_stitch.StitchServiceTests.test_incomplete_first_source_cycle_remains_explicit"]},
    {"id": "incomplete_last_source_cycle", "input": "partial final cycle in tracked tail", "expected": "boundary remains explicit", "tests": ["tests.test_stitch.StitchServiceTests.test_incomplete_last_source_cycle_remains_explicit"]},
    {"id": "multi_day_gap", "input": "timestamp gap between sources", "expected": "time axis excludes downtime", "tests": ["tests.test_continuations.ContinuationPolicyTests.test_timestamp_gap_includes_human_readable_duration"]},
    {"id": "timestamp_overlap", "input": "overlapping source timestamps", "expected": "source order remains authoritative", "tests": ["tests.test_continuations.ContinuationPolicyTests.test_timestamp_overlap_is_confirmation"]},
    {"id": "reversed_user_order", "input": "sources supplied in reverse order", "expected": "suggested order is deterministic", "tests": ["tests.test_continuations.ContinuationPolicyTests.test_reversed_order_requires_confirmation"]},
    {"id": "changed_device_channel", "input": "device/channel differs", "expected": "finding is visible", "tests": ["tests.test_continuations.ContinuationPolicyTests.test_device_and_channel_changes_are_informational"]},
    {"id": "changed_protocol_step_ids", "input": "protocol signature and numeric step IDs differ", "expected": "protocol guard refuses semantic guessing", "tests": ["tests.test_protocol_analysis_safety.ProtocolAnalysisSafetyTests.test_support_predicate_reports_only_multi_source_cells", "tests.test_continuations.ContinuationPolicyTests.test_protocol_signature_change_is_informational"]},
    {"id": "exact_duplicate_hash", "input": "same source hash twice", "expected": "atomic validation rejects it", "tests": ["tests.test_continuations.ContinuationPolicyTests.test_duplicate_hash_blocks_submit"]},
    {"id": "source_already_linked", "input": "source belongs to another Cell", "expected": "atomic validation rejects it", "tests": ["tests.test_continuations.ContinuationPolicyTests.test_hash_already_linked_blocks_submit"]},
    {"id": "missing_middle_cache", "input": "cache absent for source 2 of 3", "expected": "Cell result fails closed", "tests": ["tests.test_stitch.StitchServiceTests.test_missing_middle_source_fails_closed", "tests.test_analysis_engine.AnalysisEngineTests.test_incomplete_multi_source_cycle_result_fails_closed"]},
    {"id": "reorder_tail_and_cycles", "input": "source order changes", "expected": "tail, global cycles, and keys change", "tests": ["tests.test_source_and_replicates.MultiSourceLifecycleApiTests.test_reorder_updates_dense_positions", "tests.test_analysis_engine.AnalysisEngineTests.test_multi_source_cycle_compute_uses_shared_dense_stitch", "tests.test_analysis_staleness.SourceStalenessTests.test_reordered_files_are_stale"]},
    {"id": "scheduled_tail_scope", "input": "scheduled versus manual monitoring", "expected": "scheduled checks only tracked tail", "tests": ["tests.test_source_monitor.SourceMonitorScheduleTests.test_tracked_tail_scope_captures_one_final_source_per_cell", "tests.test_source_and_replicates.SourceAndReplicateTests.test_incompatible_manual_and_scheduled_scopes_start_separate_immutable_jobs"]},
    {"id": "portable_exact_order", "input": "multi-source Cell export/import", "expected": "ordered hashes and tail survive", "tests": ["tests.test_portable_analysis.PortableAnalysisTests.test_multi_source_portable_round_trip_preserves_cell_order_and_one_test"]},
    {"id": "portable_one_internal_test", "input": "portable import", "expected": "exactly one internal Test row", "tests": ["tests.test_portable_analysis.PortableAnalysisTests.test_multi_source_portable_round_trip_preserves_cell_order_and_one_test", "tests.test_source_and_replicates.MultiSourceLifecycleApiTests.test_new_library_cell_gets_one_internal_source_row"]},
    {"id": "second_test_creation", "input": "normal Cell lifecycle", "expected": "second Test row is rejected", "tests": ["tests.test_source_and_replicates.MultiSourceLifecycleApiTests.test_cell_level_lifecycle_rejects_multiple_internal_rows", "tests.test_source_monitor.SourceMonitorScheduleTests.test_tracked_tail_scope_rejects_multiple_internal_rows"]}
  ]
}
