{
  "description": "Synthetic, non-private continuation edge cases covered by Specs 034.1-034.9.",
  "cases": [
    {"id": "normal_continuation", "input": "local 1..3 + local 1..2", "expected": "dense global 1..5"},
    {"id": "missing_local_label", "input": "local 1,2,4", "expected": "observed labels only"},
    {"id": "incomplete_first_source_cycle", "input": "partial final cycle in source 1", "expected": "boundary remains explicit"},
    {"id": "incomplete_last_source_cycle", "input": "partial final cycle in tracked tail", "expected": "boundary remains explicit"},
    {"id": "multi_day_gap", "input": "timestamp gap between sources", "expected": "time axis excludes downtime"},
    {"id": "timestamp_overlap", "input": "overlapping source timestamps", "expected": "source order remains authoritative"},
    {"id": "reversed_user_order", "input": "sources supplied in reverse order", "expected": "suggested order is deterministic"},
    {"id": "changed_device_channel", "input": "device/channel differs", "expected": "finding is visible"},
    {"id": "changed_protocol_step_ids", "input": "protocol signature and numeric step IDs differ", "expected": "protocol guard refuses semantic guessing"},
    {"id": "exact_duplicate_hash", "input": "same source hash twice", "expected": "atomic validation rejects it"},
    {"id": "source_already_linked", "input": "source belongs to another Cell", "expected": "atomic validation rejects it"},
    {"id": "missing_middle_cache", "input": "cache absent for source 2 of 3", "expected": "Cell result fails closed"},
    {"id": "reorder_tail_and_cycles", "input": "source order changes", "expected": "tail, global cycles, and keys change"},
    {"id": "scheduled_tail_scope", "input": "scheduled versus manual monitoring", "expected": "scheduled checks only tracked tail"},
    {"id": "portable_exact_order", "input": "multi-source Cell export/import", "expected": "ordered hashes and tail survive"},
    {"id": "portable_one_internal_test", "input": "portable import", "expected": "exactly one internal Test row"},
    {"id": "second_test_creation", "input": "normal Cell lifecycle", "expected": "second Test row is rejected"}
  ]
}
