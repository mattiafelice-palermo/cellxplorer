{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CellXplorer",
  "version": "0.20.0",
  "identifier": "com.cellxplorer.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CellXplorer",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cellxplorer"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNTY3MTM0NjI5NEJFQTEKUldTaHZwUmlOSEZXSWRFbjFoUlE5SFJTdlhLUnpwdVgwZE44MGpSWFAzSHU3K3BVWTV5UExpUncK",
      "endpoints": [
        "https://raw.githubusercontent.com/mattiafelice-palermo/cellxplorer/release-channels/stable/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/backend": "binaries/backend"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "template": "cellxplorer-installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh",
        "headerImage": "nsis-header.bmp",
        "sidebarImage": "nsis-sidebar.bmp",
        "installMode": "perMachine",
        "compression": "zlib"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
